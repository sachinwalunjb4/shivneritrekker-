# Copy this file to .env and fill in your values. Never commit .env.

# --- Flask --------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# --- Business details ----------------------------------------------------
SITE_NAME=Shivneri Trekkers
CONTACT_PERSON=Santosh Dukare
CONTACT_PHONE=+91 98811 43180
CONTACT_EMAIL=hello@shivneritrekkers.example
CONTACT_ADDRESS=Narayangaon, Junnar, Pune, Maharashtra 410504
# Country code + number, digits only
WHATSAPP_NUMBER=919881143180
MAP_EMBED_URL=https://www.google.com/maps?q=Narayangaon,+Junnar,+Pune,+Maharashtra&z=14&output=embed
# "Get directions" link (Google Maps share link of your exact office pin works too)
MAP_LINK_URL=https://www.google.com/maps/search/?api=1&query=Narayangaon%2C+Junnar%2C+Pune%2C+Maharashtra

# --- Google Analytics 4 (leave empty to disable) -------------------------
GA_MEASUREMENT_ID=

# --- Email (contact form -> admin team) -----------------------------------
# Leave SMTP_HOST empty in development: emails are printed to the console.
#
# Gmail:     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (use an App Password)
# SendGrid:  SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USERNAME=apikey SMTP_PASSWORD=<your API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
ADMIN_EMAIL=bookings@yourdomain.com

# --- Razorpay (leave empty for demo checkout) -----------------------------
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
